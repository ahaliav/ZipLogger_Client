<?xml version="1.0" encoding="utf-8"?>
<!-- Clear inherited sources so this example restores from nuget.org alone, the way
     anyone cloning the repo would. Without <clear/>, a machine-level private feed
     is consulted first and fails the restore with a 401. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
