# Copy to .env and fill in. Never commit .env.
#
# Server-side ingestion key for the five backend services.
ZIPLOGGER_API_KEY=zk_...

# Separate key used by the browser storefront. This one ends up in page source,
# so keep it distinct from the server key and scope it to the demo workspace.
ZIPLOGGER_BROWSER_API_KEY=zk_...

# Where the services ship to.
ZIPLOGGER_ENDPOINT=https://app.ziplogger.ai
ZIPLOGGER_ENVIRONMENT=production

# Host port the storefront listens on, behind your reverse proxy.
STOREFRONT_HOST_PORT=8095

# How often each background service does one unit of work.
DEMO_INTERVAL_SECONDS=5
